PORT=5000
MONGO_URI=mongodb://localhost:27017/soc_siem

# ── JWT ────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_secret_key_here_change_in_production
REFRESH_SECRET=your_refresh_secret_change_in_production
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

NODE_ENV=development

# ── Rate Limiting ───────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=500

# ── Real-world data ingestion ───────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave blank ("") to disable the ingest endpoint entirely.
INGEST_API_KEY=soc-ingest-key-change-me-in-production

# ── Email Alerts (nodemailer) ───────────────────────────────────────────
# Use a Gmail App Password: https://myaccount.google.com/apppasswords
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password-16-chars
# ALERT_EMAIL=security-team@yourcompany.com

# ── CORS ────────────────────────────────────────────────────────────────
# CORS_ORIGIN=https://your-frontend.vercel.app
