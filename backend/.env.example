# SOC SIEM Dashboard — Environment Variables Reference
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is already in .gitignore.
#
# Generate secrets with:
#   node -e 'console.log(require("crypto").randomBytes(64).toString("hex"))'
#

# ── Server ──────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development   # change to "production" for deployment

# ── MongoDB ─────────────────────────────────────────────────────
# Local:
MONGO_URI=mongodb://localhost:27017/soc_siem
# MongoDB Atlas (cloud) — replace with your connection string:
# MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/soc_siem?retryWrites=true&w=majority

# ── JWT Authentication ───────────────────────────────────────────
# Generate with the command above. Use DIFFERENT values for each secret.
JWT_SECRET=CHANGE_ME_USE_64_RANDOM_HEX_CHARS
REFRESH_SECRET=CHANGE_ME_DIFFERENT_64_RANDOM_HEX_CHARS
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=500

# ── Ingest API Key ───────────────────────────────────────────────
# External agents (Windows/Linux scripts) use this key to push events.
# Generate with: node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'
# Leave blank ("") to disable the ingest endpoint entirely.
INGEST_API_KEY=CHANGE_ME_USE_32_RANDOM_HEX_CHARS

# ── Email Alerts (nodemailer) ────────────────────────────────────
# Sends an HTML email when a HIGH severity alert is ingested.
#
# Step 1: Enable 2FA on your Gmail account
# Step 2: Create an App Password at https://myaccount.google.com/apppasswords
# Step 3: Fill in below (use the 16-char app password, NOT your Gmail password)
#
# SMTP_USER=your-gmail@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop   (16-char Gmail App Password, spaces OK)
# ALERT_EMAIL=security-team@yourcompany.com

# ── CORS ─────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Use "*" to allow all (only for development).
# CORS_ORIGIN=https://your-app.vercel.app,https://soc.yourcompany.com
