{
  "name": "soc-siem-backend",
  "version": "1.0.0",
  "description": "SOC/SIEM Dashboard Backend with real-time monitoring",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --forceExit --detectOpenHandles --runInBand"
  },
  "keywords": ["soc", "siem", "security", "monitoring"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-validator": "^7.0.0",
    "geoip-lite": "^2.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^7.8.9",
    "nodemailer": "^8.0.2",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "mongodb-memory-server": "^11.0.1",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2"
  },
  "type": "commonjs",
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": ["<rootDir>/tests/setup.js"],
    "testMatch": ["<rootDir>/tests/**/*.test.js"],
    "testTimeout": 30000,
    "verbose": true
  }
}
